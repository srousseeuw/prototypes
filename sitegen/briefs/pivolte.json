    {
      "name": "Kinderdans",
      "ages": "4 – 7 jaar",
      "desc": "Een speelse kennismaking met verschillende muziek- en bewegingsstijlen die motoriek en creativiteit aanscherpt."
    },
    {
      "name": "Klassiek ballet",
      "ages": "vanaf 6 jaar",
      "desc": "De technische basis onder zowat elke dansvorm: houding, plaatsing, controle en souplesse, opgebouwd aan de barre."
    },
    {
      "name": "Jazzdans",
      "ages": "vanaf 6 jaar",
      "desc": "Modern jazz, showdance, hiphop en funk door elkaar. Draaien, sprongen en verplaatsingen, met veel expressie."
    },
    {
      "name": "Musical",
      "ages": "vanaf 8 jaar",
      "desc": "Zang en choreografie in één les: een nummer instuderen en het meteen ook dansen."
    },
    {
      "name": "Hiphop",
      "ages": "vanaf 9 jaar",
      "desc": "Streetdance uitgewerkt tot techniek, met asymmetrische arm- en beenpatronen, ritme en coördinatie."
    },
    {
      "name": "Modern",
      "ages": "vanaf 9 jaar",
      "desc": "Techniek, maar even hard gevoel, expressie en improvisatie. Ademhaling en ontspanning horen erbij."
    },
    {
      "name": "Pointes",
      "ages": "vanaf 10 jaar",
      "desc": "Ballet op spitzen, na minstens een jaar klassieke basis. Alles draait om lichtheid en elevatie."
    },
    {
      "name": "Floorwork",
      "ages": "vanaf 12 jaar",
      "desc": "Moderne techniek dicht bij de vloer: glijden, rollen, handstanden en tricks."
    }
